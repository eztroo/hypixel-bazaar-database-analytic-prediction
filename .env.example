# Salin file ini jadi ".env" (tanpa .example) lalu isi dengan Personal API Key kamu
# Cara dapat key: https://developer.hypixel.net/dashboard/ -> Create App -> Personal API Key
# CATATAN: endpoint /v2/skyblock/bazaar sebenarnya keyless (bisa tanpa key),
# tapi kita tetap simpan slot untuk key karena beberapa endpoint lain (mis. mayor/election di Phase 8) membutuhkannya.

HYPIXEL_API_KEY=

# Interval fetch bazaar dalam detik (dipakai mulai Phase 5, disiapkan dari sekarang)
FETCH_INTERVAL_SECONDS=60
